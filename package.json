{
  "name": "@earth-app/moho",
  "description": "An NPM package with a curated list of special events used by The Earth App",
  "version": "1.1.0",
  "author": "earth-app",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "src",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example": "bun run example/example.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node --format=esm --minify --sourcemap=linked && bunx tsc --project tsconfig.build.json",
    "compile": "bunx babel src --out-dir out --extensions \".ts\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:live": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=/node_modules/ --testMatch=\"**/test/live/*.live.test.ts\"",
    "typecheck": "bunx tsc --noEmit",
    "data:places": "bun run scripts/fetch-places.ts",
    "data:colleges": "bun run scripts/fetch-colleges.ts",
    "data:sports": "bun run scripts/fetch-sports.ts",
    "data:cosmic": "bun run scripts/generate-cosmic.ts",
    "data:all": "bun run data:cosmic && bun run data:sports-dates && bun run data:places && bun run data:colleges && bun run data:sports && bun run data:space",
    "verify:refresh": "bun run scripts/verify-data.ts",
    "prettier": "bunx prettier --write .",
    "prettier:check": "bunx prettier --check .",
    "prepare": "husky install",
    "doc": "jsdoc out/* -d docs -R README.md",
    "data:space": "bun run scripts/fetch-space.ts",
    "data:sports-dates": "bun run scripts/generate-sports-dates.ts"
  },
  "lint-staged": {
    "*.{ts,js,cjs,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "@types/bun": "latest",
    "babel-plugin-add-module-exports": "^1.0.4",
    "docdash": "^2.0.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.5",
    "jsdoc-babel": "^0.5.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "ts-jest": "^29.4.12"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "bugs": {
    "url": "https://github.com/earth-app/moho/issues"
  },
  "homepage": "https://github.com/earth-app/moho#readme",
  "keywords": [
    "calendar",
    "dates",
    "events",
    "holidays",
    "birthdays",
    "recurring-events"
  ]
}
